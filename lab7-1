// Program PuttyTat: Concatenates two input files into a third output file,
// with the option to append or overwrite the output file. Prompts the user
// for file names and validates that all files open successfully.
//
// Pseudocode/Algorithm:
//	Input: 
//		- First input file name (from user via getstring)
//		- Second input file name (from user via getstring)
//		- Output file name (from user via getstring)
//		- Append option Y/N (from user via getstring)
//
//	Processing:
//		1. Display prompt and read first input file name
//		2. Display prompt and read second input file name
//		3. Display prompt and read output file name
//		4. Display prompt and read append option (Y/N)
//		5. Open first input file (read-only mode)
//		   - If error, display error message and exit
//		6. Open second input file (read-only mode)
//		   - If error, display error message and exit
//		7. Determine flags for output file based on append option
//		   - If 'Y': use append flags (O_WRONLY | O_CREAT | O_APPEND)
//		   - Else: use overwrite flags (O_WRONLY | O_CREAT | O_TRUNC)
//		8. Open output file with determined flags
//		   - If error, display error message and exit
//		9. Allocate buffer on stack for reading/writing
//		10. Copy first input file to output file in chunks
//		11. Copy second input file to output file in chunks
//		12. Deallocate buffer
//		13. Close all three files
//		14. Exit program successfully
//
//	Output:
//		- Combined content of both input files written to output file
//		- Error messages if files fail to open
//		- Normal program termination

.global _start			// Provide program starting address

_start:
	.equ	BUFFER_SIZE, 64		// Buffer size for file names
	.equ	READ_BUFFER_SIZE, 4096	// Buffer size for reading file content (4KB)
	
	// Linux system call numbers
	.equ	SYS_READ, 63
	.equ	SYS_WRITE, 64
	.equ	SYS_OPENAT, 56
	.equ	SYS_CLOSE, 57
	.equ	SYS_EXIT, 93
	
	// File access modes and flags
	.equ	AT_FDCWD, -100		// Current working directory file descriptor
	.equ	O_RDONLY, 00000		// Open for reading only
	.equ	A_C_RW, 02102		// Append, Create, Read/Write (octal: 02=RW, 0100=Create, 02000=Append)
	.equ	T_C_RW, 01101		// Truncate, Create, Read/Write (octal: 01=Write, 0100=Create, 01000=Trunc)
	.equ	RW_RW____, 0660		// File permissions: owner RW, group RW, others none

	.bss

	// Buffers for file names
	input1_name:	.skip	BUFFER_SIZE	// Buffer for first input file name
	input2_name:	.skip	BUFFER_SIZE	// Buffer for second input file name
	output_name:	.skip	BUFFER_SIZE	// Buffer for output file name
	append_choice:	.skip	BUFFER_SIZE	// Buffer for append choice (Y/N)

	.text

// ========== Get first input file name and open ==========
	LDR	X0, =promptFile1	// Load address of first prompt
	BL	putstring		// Display prompt using putstring function
	
	LDR	X0, =input1_name	// Load address of buffer for first file name
	MOV	X1, #BUFFER_SIZE	// Set buffer size
	BL	getstring		// Read first file name from user
	
	// Open first input file with read-only mode
	MOV	X0, #AT_FDCWD		// Use current working directory
	LDR	X1, =input1_name	// Load address of first input file name
	MOV	X2, #O_RDONLY		// Open in read-only mode
	MOV	X3, #RW_RW____		// File permissions (owner RW, group RW, others none)
	MOV	X8, #SYS_OPENAT		// System call number for openat
	SVC	0			// Make system call
	
	CMP	X0, #0			// Check if file descriptor is negative (error)
	B.LT	invalidFileIn1		// If error, branch to error handler
	MOV	X19, X0			// Save file descriptor for input file 1

// ========== Get second input file name and open ==========
	LDR	X0, =promptFile2	// Load address of second prompt
	BL	putstring		// Display prompt using putstring function
	
	LDR	X0, =input2_name	// Load address of buffer for second file name
	MOV	X1, #BUFFER_SIZE	// Set buffer size
	BL	getstring		// Read second file name from user
	
	// Open second input file with read-only mode
	MOV	X0, #AT_FDCWD		// Use current working directory
	LDR	X1, =input2_name	// Load address of second input file name
	MOV	X2, #O_RDONLY		// Open in read-only mode
	MOV	X3, #RW_RW____		// File permissions (owner RW, group RW, others none)
	MOV	X8, #SYS_OPENAT		// System call number for openat
	SVC	0			// Make system call
	
	CMP	X0, #0			// Check if file descriptor is negative (error)
	B.LT	invalidFileIn2		// If error, branch to error handler
	MOV	X20, X0			// Save file descriptor for input file 2

// ========== Get output file name ==========
	LDR	X0, =promptOutFile	// Load address of third prompt
	BL	putstring		// Display prompt using putstring function
	
	LDR	X0, =output_name	// Load address of buffer for output file name
	MOV	X1, #BUFFER_SIZE	// Set buffer size
	BL	getstring		// Read output file name from user

// ========== Get append choice ==========
	LDR	X0, =promptAppend	// Load address of fourth prompt
	BL	putstring		// Display prompt using putstring function
	
	LDR	X0, =append_choice	// Load address of buffer for append choice
	MOV	X1, #BUFFER_SIZE	// Set buffer size
	BL	getstring		// Read append choice from user

// ========== Determine output file mode and open ==========
	LDR	X0, =append_choice	// Load address of append choice buffer
	LDRB	W1, [X0]		// Load first character of append choice
	
	CMP	W1, #'Y'		// Compare with 'Y'
	B.EQ	appendFile		// If 'Y', use append mode
	CMP	W1, #'y'		// Compare with 'y' (lowercase)
	B.EQ	appendFile		// If 'y', use append mode
	
	// Use truncate mode (overwrite)
	MOV	X0, #AT_FDCWD		// Use current working directory
	LDR	X1, =output_name	// Load address of output file name
	MOV	X2, #T_C_RW		// Flags: Truncate, Create, Read/Write
	MOV	X3, #RW_RW____		// File permissions (owner RW, group RW, others none)
	MOV	X8, #SYS_OPENAT		// System call number for openat
	SVC	0			// Make system call
	
	CMP	X0, #0			// Check if file descriptor is negative (error)
	B.LT	invalidFileOut		// If error, branch to error handler
	MOV	X18, X0			// Save file descriptor for output file
	B	readFileInput		// Start reading from files

appendFile:
	// Use append mode
	MOV	X0, #AT_FDCWD		// Use current working directory
	LDR	X1, =output_name	// Load address of output file name
	MOV	X2, #A_C_RW		// Flags: Append, Create, Read/Write
	MOV	X3, #RW_RW____		// File permissions (owner RW, group RW, others none)
	MOV	X8, #SYS_OPENAT		// System call number for openat
	SVC	0			// Make system call
	
	CMP	X0, #0			// Check if file descriptor is negative (error)
	B.LT	invalidFileOut		// If error, branch to error handler
	MOV	X18, X0			// Save file descriptor for output file

readFileInput:
	// Allocate buffer on the stack
	SUB	SP, SP, #READ_BUFFER_SIZE	// Allocate 4KB buffer on stack
	MOV	X21, SP				// X21 points to our buffer

// ========== Copy first input file to output file ==========
copy_file1_loop:
	// Read from first input file
	MOV	X0, X19			// File descriptor of first input file
	MOV	X1, X21			// Buffer address
	MOV	X2, #READ_BUFFER_SIZE	// Buffer size (4096 bytes)
	MOV	X8, #SYS_READ		// System call number for read
	SVC	0			// Make system call
	
	CMP	X0, #0			// Check bytes read
	B.LE	done_file1		// If zero or negative, done reading
	
	// Write to output file
	MOV	X2, X0			// Number of bytes read (to write)
	MOV	X0, X18			// File descriptor of output file
	MOV	X1, X21			// Buffer address
	MOV	X8, #SYS_WRITE		// System call number for write
	SVC	0			// Make system call
	
	B	copy_file1_loop		// Continue copying until EOF

done_file1:
// ========== Copy second input file to output file ==========
copy_file2_loop:
	// Read from second input file
	MOV	X0, X20			// File descriptor of second input file
	MOV	X1, X21			// Buffer address
	MOV	X2, #READ_BUFFER_SIZE	// Buffer size (4096 bytes)
	MOV	X8, #SYS_READ		// System call number for read
	SVC	0			// Make system call
	
	CMP	X0, #0			// Check bytes read
	B.LE	done_file2		// If zero or negative, done reading
	
	// Write to output file
	MOV	X2, X0			// Number of bytes read (to write)
	MOV	X0, X18			// File descriptor of output file
	MOV	X1, X21			// Buffer address
	MOV	X8, #SYS_WRITE		// System call number for write
	SVC	0			// Make system call
	
	B	copy_file2_loop		// Continue copying until EOF

done_file2:
	// Deallocate buffer from stack
	ADD	SP, SP, #READ_BUFFER_SIZE	// Release buffer space
	B	terminate		// Jump to termination routine

// ========== Error Handlers ==========

invalidFileIn1:
	// Display error message for first input file
	LDR	X0, =inFileError	// Load address of error message
	BL	putstring		// Display error message
	
	LDR	X0, =input1_name	// Load address of file name
	BL	putstring		// Display file name
	
	LDR	X0, =newline		// Load address of newline
	BL	putstring		// Display newline
	
	B	terminate		// End program

invalidFileIn2:
	// Display error message for second input file
	LDR	X0, =inFileError	// Load address of error message
	BL	putstring		// Display error message
	
	LDR	X0, =input2_name	// Load address of file name
	BL	putstring		// Display file name
	
	LDR	X0, =newline		// Load address of newline
	BL	putstring		// Display newline
	
	// Close first input file before exiting
	MOV	X0, X19			// File descriptor of first input file
	MOV	X8, #SYS_CLOSE		// System call number for close
	SVC	0			// Make system call
	
	B	terminate		// End program

invalidFileOut:
	// Display error message for output file
	LDR	X0, =outFileError	// Load address of error message
	BL	putstring		// Display error message
	
	LDR	X0, =output_name	// Load address of file name
	BL	putstring		// Display file name
	
	LDR	X0, =newline		// Load address of newline
	BL	putstring		// Display newline
	
	// Close both input files before exiting
	MOV	X0, X19			// File descriptor of first input file
	MOV	X8, #SYS_CLOSE		// System call number for close
	SVC	0			// Make system call
	
	MOV	X0, X20			// File descriptor of second input file
	MOV	X8, #SYS_CLOSE		// System call number for close
	SVC	0			// Make system call
	
	B	terminate		// End program

terminate:
	// Close all files and terminate the program
	MOV	X0, X19			// File descriptor of first input file
	MOV	X8, #SYS_CLOSE		// System call number for close
	SVC	0			// Make system call
	
	MOV	X0, X20			// File descriptor of second input file
	MOV	X8, #SYS_CLOSE		// System call number for close
	SVC	0			// Make system call
	
	MOV	X0, X18			// File descriptor of output file
	MOV	X8, #SYS_CLOSE		// System call number for close
	SVC	0			// Make system call
	
	MOV	X0, #0			// Set return code to 0 (success)
	MOV	X8, #SYS_EXIT		// System call number for exit
	SVC	0			// Make system call

	.data

	// Prompts for user input
	promptFile1:	.asciz	"Enter first input file name : "
	promptFile2:	.asciz	"Enter second input file name: "
	promptOutFile:	.asciz	"Enter output file name      : "
	promptAppend:	.asciz	"Append to the output? [Y/N] : "

	// Error messages
	inFileError:	.asciz	"Fatal error: failed to open input file "
	outFileError:	.asciz	"Fatal error: failed to open output file "
	newline:	.asciz	"\n"

.end	// End of program, good practice
